// stow/rofi/.config/rofi/theme-base.rasi
// Structural settings only. Colors live in theme-soft.rasi / theme-contrast.rasi
// and get concatenated onto this file by gen-theme.sh to produce theme.rasi,
// which config-base.rasi references via @theme.

window {
    width:                        600px;
    height:                       400px;
    location:                     center;
    border:                       2px;
    border-radius:                8px;
    padding:                      10px;
}

mainbox {
    children:                     [ "inputbar", "listview" ];
    spacing:                      10px;
}

inputbar {
    children:                     [ "prompt", "entry" ];
    padding:                      8px;
    border-radius:                6px;
    border:                       0px;
}

prompt {
    padding:                      0 8px 0 0;
}

prompt {
    padding:                      0 8px 0 0;
    border:                       0px;
}

entry {
    placeholder:                  "Search...";
}

listview {
    lines:                        8;
    scrollbar:                    false;
    padding:                      4px 0;
}

element {
    padding:                      6px 8px;
    border-radius:                6px;
}

element-icon {
    size:                         24px;
}

entry {
    border:                       0px;
}
// stow/rofi/.config/rofi/theme-contrast.rasi
// High-contrast palette for bright/outdoor lighting, matching
// kitty-theme-contrast.conf and style-theme-contrast.css.
// Concatenated onto theme-base.rasi by gen-theme.sh.

* {
    background:                   #000000ff;
    background-alt:               #202020ff;
    foreground:                   #ffffffff;
    selected:                     #ffffffff;
    active:                       #33ff33ff;
    urgent:                       #ff3333ff;
}

window {
    background-color:             @background;
    border-color:                 @foreground;
}

inputbar {
    background-color:             @background-alt;
    text-color:                   @foreground;
}

prompt {
    text-color:                   #5599ffff;
    background-color:             @background-alt;
}

entry {
    text-color:                   @foreground;
    placeholder-color:            #808080ff;
    background-color:             @background-alt;
}

listview {
    background-color:             @background;
}

element normal.normal {
    background-color:             @background;
    text-color:                   @foreground;
}

element selected.normal {
    background-color:             @selected;
    text-color:                   #000000ff;
}

element alternate.normal {
    background-color: @background;
    text-color: @foreground;
}

element-icon {
    background-color: transparent; 
}

element-text {
    background-color:             transparent;
    text-color:                   inherit;
}

mainbox {
    background-color:             @background;
}

element normal.active {
    background-color:             @background;
    text-color:                   @foreground;
}

element alternate.active {
    background-color:             @background;
    text-color:                   @foreground;
}

element selected.active {
    background-color:             @selected;
    text-color:                   #000000ff;
}
